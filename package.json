    "node": ">=18"
  },
  "scripts": {
    "build": "python3 build/build.py",
    "build:dev": "python3 build/build.py --no-minify",
    "serve": "node tools/serve.js",
    "test": "node tests/smoke.test.js",
    "og-images": "node tools/og-image.js en && node tools/og-image.js bn"
  },
