{
  "appId": "com.aiinfos.businesscardmaker",
  "appName": "Card Maker",
  "webDir": "dist/mobile",
  "backgroundColor": "#F6F3EC",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#2E5A4D",
      "showSpinner": false
    }
  }
}
